# ============ Daho miya — Railway Variables namunasi ============
# Haqiqiy qiymatlarni Railway → Variables bo'limiga kiriting, GitHub'ga yubormang.

PORT=8080
NODE_ENV=production

# Holat va workspace saqlanadigan joy (Railway Volume ulash tavsiya etiladi)
DATA_DIR=/data
ALLOWED_WORKSPACE=/data/workspace

# Ilova bilan server orasidagi kirish tokeni (bo'sh qoldirsa — ochiq)
APP_TOKEN=

# AI provayderlar — bittasi ham yetarli, qolganini keyin ilovadan qo'shasiz
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Telegram: topshiriq tugagani, kerakli kalit va yangi topshiriqlar shu yerdan yuradi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Miya xulqi
ALLOW_SHELL=true
PROVIDER_TIMEOUT_MS=120000

# test_app uchun headless brauzer (topilmasa faqat sintaksis tekshiriladi)
# Railway/Nixpacks: NIXPACKS_PKGS=chromium qo'shing, so'ng:
# CHROME_PATH=/usr/bin/chromium

# Ixtiyoriy: o'z gateway/proxy manzillaringiz
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# GitHub qo'llari: repo o'qish/yozish, PR, Actions, Pages
GITHUB_TOKEN=
GITHUB_OWNER=UZBLEADERRR
GITHUB_REPO=daho-code-agent
GITHUB_BRANCH=main
# GitHub Enterprise ishlatilsa:
# GITHUB_API_URL=https://github.company.com/api/v3
RAILWAY_DEPLOY_HOOK_URL=
